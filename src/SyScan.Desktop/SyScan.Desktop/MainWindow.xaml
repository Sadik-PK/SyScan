<Window x:Class="SyScan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SyScan.Desktop.Views"
        Title="SyScan"
        Width="900" Height="640"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource SyScanWindowStyle}"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <!-- Content frame — swapped by NavigationService -->
        <ContentControl x:Name="MainContent"/>

        <!-- Title bar accent line -->
        <Rectangle Height="2" VerticalAlignment="Top"
                   HorizontalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F8EF7" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</Window>
